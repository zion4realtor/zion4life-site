// Cloudflare Workers config for zion4life.faith.
// Cloudflare runs `npx wrangler deploy` on every push to main: it builds dist/ with
// build.mjs, then uploads dist/ as static assets plus src/worker.js, which runs for
// /api/*, /g/<id> (搭子 pages) and /x/<id> (posts by tag managers), also under /en/.
// STORE is a SQLite-backed Durable Object holding accounts, 留言, posts and 搭子; the
// cron trigger runs every 5 minutes and emails members as each 搭子 session starts.
{
  "name": "zion4life",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  // The sender of every email (zion4life.faith is verified in Resend) and Zion's admin
  // accounts (the first is his own, made as the platform's first account). The Resend key
  // itself is the Secret RESEND_API_KEY, set in the Cloudflare dashboard.
  // GA_MEASUREMENT_ID is Google Analytics account 有光 → property 有光 zion4life.faith → web stream
  // 有光 (src/analytics.js); its Measurement Protocol key is the Secret GA_API_SECRET, set in the
  // Cloudflare dashboard.
  "vars": { "FROM_EMAIL_ADDRESS": "有光 <light@zion4life.faith>", "ADMIN_EMAILS": "light@zion4life.faith,zion.chen@hotmail.com", "GA_MEASUREMENT_ID": "G-VP8BKCZ3TE" },
  // Workers AI records the 呼吸 for 读给我听 (src/audio.js).
  "ai": { "binding": "AI" },
  "build": { "command": "node build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/g/*", "/en/g/*", "/x/*", "/en/x/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
