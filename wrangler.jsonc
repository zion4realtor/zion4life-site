// Cloudflare Workers config for zion4life.faith.
// Cloudflare runs `npx wrangler deploy` on every push to main: it builds dist/ with
// build.mjs, then uploads dist/ as static assets plus src/worker.js, which runs for
// /api/*, /g/<id> (搭子 pages) and /x/<id> (posts by tag managers), also under /en/.
// STORE is a SQLite-backed Durable Object holding accounts, 留言, posts and 搭子; the
// cron trigger runs every 5 minutes and emails members as each 搭子 session starts.
{
  "name": "zion4life",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "build": { "command": "node build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/g/*", "/en/g/*", "/x/*", "/en/x/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
